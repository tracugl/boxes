#!/usr/bin/env bash
# Hexmo Drive: export helix-ring layouts and serve the drivable 3D preview.
#
#   scripts/hexmo-drive                  serve (exports every layout first if none are)
#   scripts/hexmo-drive LAYOUT ...       re-export those layouts, then serve
#   scripts/hexmo-drive --all            re-export every layout, then serve
#
# Layouts: N250, N250-ground, HO, HO-ground, each alone or as a joined pair
# (append -x2, e.g. HO-ground-x2).  The export runs in the Docker container
# (it needs build123d); the web server runs here, on every interface, so
# other machines on the network can open it too.  PORT overrides 4456.
set -euo pipefail
cd "$(dirname "$0")/.."
PORT="${PORT:-4456}"
DIR=docs/hexmohexagon/drive

if [[ $# -gt 0 || ! -f "$DIR/layouts.json" ]]; then
  layouts="${*:---all}"
  docker compose exec -T web sh -c \
    "cd /app && PYTHONPATH=/app /app/env/bin/python -W ignore -m boxes.generators._hexmo_drive $layouts"
fi

echo "Hexmo Drive: http://$(hostname):$PORT/  (Ctrl+C to stop)"
exec python3 -m http.server "$PORT" -d "$DIR" --bind 0.0.0.0
